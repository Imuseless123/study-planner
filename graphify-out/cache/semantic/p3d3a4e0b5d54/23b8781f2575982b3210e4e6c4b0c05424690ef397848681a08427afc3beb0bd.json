{"nodes": [{"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_lp_optimization_engine", "label": "LP Optimization Engine (Tier 3)", "file_type": "document", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tier 3 is described as the most complex tier using operations research optimisation, not novel AI, positioned as an independent microservice on port 8002 to complete the 3-tier architecture."}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_milp_model_builder", "label": "MILP Model Builder model.py", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_solve_schedule", "label": "solve_schedule in solver.py", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_diminishing_returns", "label": "Diminishing Returns piecewise-linear sqrt(x) approximation", "file_type": "rationale", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4-segment piecewise linear approximation with decreasing slopes (1.414, 0.586, 0.414, 0.293) lets the maximisation LP fill the highest-slope segment first with no binary variables for segment ordering, reducing MILP complexity and solving faster."}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_soft_constraints", "label": "Soft Constraints deadline and daily cap", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soft constraints with penalty lambda_daily=100 (lambda_deadline=20) ensure the solver always returns a feasible schedule with warnings rather than Infeasible; penalty must dominate max marginal gain E_max*slope_max ~35 so overflow is never abused and deadlines are preferred over daily overload."}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_hard_constraints", "label": "Hard Constraints 7 groups", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_w_max_effective", "label": "W_max_effective risk integration", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Risk score from Tier 2 scales the daily cap to avoid the positive feedback loop where high risk lowers W_max_effective making deadlines infeasible; combined with soft constraints and fallback retry it mitigates infeasibility."}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_fallback_two_step", "label": "2-step Fallback on Infeasible", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 1 solves with W_max_effective, Step 2 retries with original W_max plus user warning to preserve usability under high risk and heavy workloads."}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_default_lambda_daily", "label": "DEFAULT_LAMBDA_DAILY single source of truth", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bug in solver.py hardcoded 5.0 causing HTTP vs direct-call inconsistency; importing DEFAULT_LAMBDA constants guarantees one source of truth and consistent behaviour across HTTP and direct paths."}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_thesis_example", "label": "Thesis Example section 4.5.6", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_daily_logs_2026_10_19_tier_3_lp_solver_coinor_cbc", "label": "coinor-cbc solver backend", "file_type": "concept", "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_lp_optimization_engine", "target": "docs_daily_logs_2026_10_19_tier_3_lp_solver_milp_model_builder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_lp_optimization_engine", "target": "docs_daily_logs_2026_10_19_tier_3_lp_solver_diminishing_returns", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_soft_constraints", "target": "docs_daily_logs_2026_10_19_tier_3_lp_solver_default_lambda_daily", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_soft_constraints", "target": "docs_daily_logs_2026_10_19_tier_3_lp_solver_w_max_effective", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_w_max_effective", "target": "docs_daily_logs_2026_10_19_tier_3_lp_solver_fallback_two_step", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_milp_model_builder", "target": "lp_solver_requirements_pulp", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_thesis_example", "target": "docs_daily_logs_2026_10_19_tier_3_lp_solver_lp_optimization_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_daily_logs_2026_10_19_tier_3_lp_solver_coinor_cbc", "target": "docs_daily_logs_2026_10_19_tier_3_lp_solver_milp_model_builder", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/daily-logs/2026-10-19-tier-3-lp-solver.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "lp_solver_milp_optimisation_flow", "label": "MILP optimisation flow with risk scaling and fallback", "nodes": ["docs_daily_logs_2026_10_19_tier_3_lp_solver_milp_model_builder", "docs_daily_logs_2026_10_19_tier_3_lp_solver_w_max_effective", "docs_daily_logs_2026_10_19_tier_3_lp_solver_fallback_two_step", "docs_daily_logs_2026_10_19_tier_3_lp_solver_solve_schedule"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score":